{
  "name": "odas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun scripts/start.ts",
    "seed": "bun scripts/seed.ts",
    "seed:reservations": "bun scripts/seed-reservations.ts",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test:integration": "bun scripts/integration.ts",
    "test:scenario": "bun scripts/scenario.ts",
    "actors:generate": "bun scripts/generate-actors.ts",
    "operator:create": "bun scripts/provision-operator.ts",
    "operator:grant-control": "bun scripts/grant-device-control.ts",
    "db:migrate-sqlite": "bun scripts/migrate-sqlite.ts"
  },
  "dependencies": {
    "@agent-relay/sdk": "15.0.1",
    "@relaycast/sdk": "12.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@odas/contracts": "workspace:*",
    "hono": "4.13.14",
    "leaflet": "1.9.4",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.18.5",
    "stripe": "23.1.0",
    "terse-sdk": "0.14.9",
    "zod": "4.6.7",
    "@relaycast/engine": "12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "terse-cli": "0.14.9",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}

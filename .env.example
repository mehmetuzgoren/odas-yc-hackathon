# Copy to .env; never commit secrets. Local startup creates missing internal/dev secrets.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3000
WEB_PORT=5173
DATA_DIR=.data/development
ODAS_NAMESPACE=development
ACTOR_PORT=7100
ACTOR_PROJECT_ID=odas-development
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/odas-development/actors
# Set for managed Terse production and regenerate native clients before release.
TERSE_API_KEY=
TERSE_ACTOR_SECRET=
INTERNAL_TOKEN=
DEVICE_PORT=8090
DEVICE_MODE=simulator
# Simulator data are always labeled. Physical configuration lives in workers/device.
DEVICE_BINDINGS_FILE=
DEV_GUEST_EMAIL=guest@odas.local
DEV_OPERATOR_EMAIL=operator@odas.local
DEV_GUEST_PASSWORD=
DEV_OPERATOR_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INTEGRATION_IDENTIFIER=odas_hourly_checkout_abcdefgh
# Use a hosted Relaycast workspace or the documented local Relaycast engine.
RELAYCAST_BASE_URL=
RELAYCAST_API_KEY=
# Without a key, conversations use labeled development rules. Set rules to force that mode.
CONCIERGE_MODE=model
OPENAI_API_KEY=
CONCIERGE_MODEL=gpt-6-luna
CONCIERGE_MODEL_BASE_URL=https://api.openai.com/v1
# Isolated integration fixture only. Cannot be combined with physical mode.
ODAS_TEST_MODE=0
ODAS_TEST_NOW=

# Configurable product policy (all values validated on server).
CHECK_IN_WINDOW_MINUTES=15
CANCELLATION_POLICY_TEXT=
CLEANING_ESTIMATE_MINUTES=10
RELAY_PORT=8787
RELAY_NODE_BINARY=
# Physical devices: requires explicit physical bindings and commissioning.
ROBOROCK_EMAIL=
ROBOROCK_USER_DATA_FILE=
ROBOROCK_DEVICE_DUID=
OFFICE_CAMERA_RTSP_URL=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
TURNOVER_BUFFER_MINUTES=15
REPLACEMENT_OFFER_MINUTES=10
# Optional private input to the separate operator provisioning command.
OPERATOR_PASSWORD=

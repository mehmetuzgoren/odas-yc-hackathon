# Backend deployment secrets; placeholders only. The root supervisor passes them to this process.
DEVICE_MODE=physical
DEVICE_PORT=8090
DEVICE_HOST=127.0.0.1
DEVICE_BINDINGS_FILE=workers/device/physical.bindings.example.json
# INTERNAL_TOKEN must match the API and contain at least 24 random characters.
INTERNAL_TOKEN=
API_INTERNAL_URL=http://127.0.0.1:3000
ROBOROCK_EMAIL=
ROBOROCK_USER_DATA_FILE=/run/secrets/roborock-user.json
ROBOROCK_DEVICE_DUID=
OFFICE_CAMERA_RTSP_URL=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
FFMPEG_BIN=ffmpeg
